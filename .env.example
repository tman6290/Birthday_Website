NEXT_PUBLIC_SITE_URL=http://localhost:3000

DATABASE_URL=

# Staff sign-in. host can open /admin and /door; door1 and door2 can open /door.
HOST_PASSWORD=
DOOR1_PASSWORD=
DOOR2_PASSWORD=

# Any 32+ random characters. Changing it signs every staff phone out.
SESSION_SECRET=

# WhatsApp Cloud API (Meta). Leave empty to turn WhatsApp off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: your WhatsApp number, for `npm run whatsapp:test`
WHATSAPP_TEST_TO=

# Any long random string. Vercel Cron sends it to /api/cron/whatsapp.
CRON_SECRET=
